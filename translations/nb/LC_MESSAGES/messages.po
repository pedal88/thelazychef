msgstr "(valgfritt)"

msgid "Choose one"
msgstr "Velg"

msgid "Google or another search"
msgstr "Google eller en annen søkemotor"

msgid "A friend"
msgstr "En venn"

msgid "Somewhere else"
msgstr "Et annet sted"

