msgstr "Opprett konto"

msgid "How we handle your data: <a href=\"/privacy\">Privacy</a>."
msgstr "Slik behandler vi dataene dine: <a href=\"/privacy\">Personvern</a>."

msgid ""
"Continue with Google works in Safari or Chrome: open this page there, from the <b>⋯</b> menu at the top. Or use your "
