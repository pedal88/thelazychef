# Copy to .env for local runs. Every variable the app reads is listed here (tests/test_docs.py checks it);
# what each is for: docs/SERVICES_AND_COSTS.md. Never commit .env.

FLASK_APP=app.py
FLASK_DEBUG=1
# Session signing key, required on Cloud Run. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# AI: Gemini (images, video, ingredient analysis) and Claude (recipes, pantry job, image checks)
GOOGLE_API_KEY=your-gemini-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key

# Database: local (SQLite, the default) or cloudsql. DATABASE_URL overrides the URL (tests: sqlite://);
# leave it commented out unless you need it: an empty value is not the same as none
DB_BACKEND=local
# DATABASE_URL=sqlite:////absolute/path/local.db
# Required with DB_BACKEND=cloudsql
INSTANCE_CONNECTION_NAME=
DB_USER=
DB_PASS=
DB_NAME=

# Files: local (static/, the default) or gcs
STORAGE_BACKEND=local
# Required with STORAGE_BACKEND=gcs
GCS_BUCKET_NAME=

# Background jobs (Cloud Tasks). Leave TASKS_QUEUE empty locally: generation then runs in the request
TASKS_QUEUE=
TASKS_LOCATION=europe-west1
TASKS_SERVICE_ACCOUNT=

# The content API (docs/CONTENT.md): Claude Code sends drafts with this key. Empty: the API is off.
CONTENT_API_KEY=
# Continue with Google (services/google_signin.py): an OAuth client of the type Web application. Empty: no button.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
APP_BASE_URL=
GOOGLE_CLOUD_PROJECT=thelazychefai-prod

# Scripts and the prompt lab only (leave commented out when unused: an empty value is not the same as none)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# GOOGLE_CLOUD_LOCATION=europe-west1
# PROMPTLAB_DIR=~/promptlab-runs
# PROMPTLAB_NO_OPEN=1
